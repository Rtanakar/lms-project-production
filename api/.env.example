# ===== App =====
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# ===== Database (Postgres) =====
# DATABASE_URL → runtime (pgbouncer/pooled in prod, e.g. Supabase 6543)
DATABASE_URL=""

# ===== Upstash Redis =====
# Get from https://console.upstash.com → your DB → "REDIS URL" (TLS, rediss://)
REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379
# rediss://default:gQAAAAAAA
# Token: gQAAAAAAA
# Read Only Token: ggAAAAAAA
# redis-cli --tls -u redis://default:
# TCP: REDIS_URL=""rediss://default:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===== JWT (Better Auth signs on Next.js, NestJS verifies) =====
JWT_PUBLIC_KEY=
JWT_ISSUER=lms-auth
JWT_AUDIENCE=lms-api

# Better-Auth
BETTER_AUTH_SECRET=CkRNgXDA9LVhLH3rsX1d3jD49O9DDrQT
BETTER_AUTH_URL="http://localhost:3000" # Base URL of your app
ADMIN_EMAILS=""

# Github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ===== Cloudflare R2 =====
# Dashboard → R2 → Manage R2 API Tokens
# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="lms-project"
R2_TOKEN=""
R2_PUBLIC_URL=""
# https://
# https://pub-fhgfh46gryhhh.r2.dev

# ===== Resend (email) =====
